# Copy to a local env file or export these in the host environment.
# Do not commit real secrets. .env and .env.* are gitignored; this example is not.

# Comma-separated browser origins allowed to call the API.
# Required when NODE_ENV=production. In development, http://localhost, 127.0.0.1,
# and [::1] (any port) are allowed when this is unset.
# CORS_ORIGINS=https://levelupauto.example,https://alset.example

# Shared password for Alset demo accounts created by scripts/src/seed-alset.ts.
# The seed script exits without writing if this is unset.
# SEED_DEMO_PASSWORD=

# Secret used to sign Alset auth tokens. Required by the API server.
# ALSET_AUTH_SECRET=

# PostgreSQL connection string used by the API server and seed scripts.
# DATABASE_URL=

# Port the API server listens on. Required.
# PORT=3000

# Optional contact-form rate limit (POST /api/contact). Defaults: 5 requests / 15 minutes per IP.
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_MS=900000
